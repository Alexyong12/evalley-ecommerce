# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and is read automatically by Next.js.

# --- Database ---------------------------------------------------------------
# Leave both blank for local development: the app falls back to data/evalley.db.
# On Vercel these MUST be set (Project -> Settings -> Environment Variables),
# because the serverless filesystem is read-only and every write to a bundled
# .db file fails - that is why POST requests (login, register, cart) return 500.
# Get them with:  turso db show evalley --url   /   turso db tokens create evalley
TURSO_DATABASE_URL=libsql://evalley-kionyong.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3ODkwMTM3MTIsImlkIjoiMDFhMDg5ODUtMzIwMS03MzZiLWEzNGEtMzYzZjY0YjM5NTNmIiwia2lkIjoiWmt1V1I1WHlXRW9RNzI2bmwwVEZkaGlhV0xtMjdTVTdScGd5M1FScmtWRSIsInJpZCI6ImQ0ZTQyNGViLTc0OTUtNDRhOS05ZTE1LTIzMzg2NTQwYjI0NyJ9.TEOML4rSaMLapj9LbnSaWwtMz_d1EVO7sQo12VxyBoixYa-AFI-UobGVdutZX7PeB_ZNzt0F1IHfSaHZXok8Dg

# --- SMS (optional) ---------------------------------------------------------
